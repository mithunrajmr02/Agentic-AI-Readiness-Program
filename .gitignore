# Environment Variables
.env
.env.*
**/.env
# ...but the committed template MUST be tracked -- it is the only in-repo record
# of which variables the code actually reads. `.env.*` above would otherwise
# swallow it, which is how this repo ended up with no example file at all.
!.env.example

# Python Bytecode & Caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Agent tooling: launch.json describes how to start this project's dev servers
# and is worth sharing; settings.local.json is a per-machine permission cache
# full of absolute paths from one developer's box and must not be.
.claude/settings.local.json

# Vector Stores & Databases
chroma_db/
**/chroma_db/
*.db
*.sqlite
*.sqlite3

# WS-8 local runtime artifacts (checkpoint.py / ledger.py) -- stand-ins for
# tables/services this stream does not own; see
# docs/implementation/integration-requests/WS-8.md
data/graph_checkpoints.pkl*
data/agent_ledger.jsonl

# Virtual Environments
venv/
**/venv/
ENV/
env/
.venv/

# Node & Frontend
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
npm-debug.log*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scanner & Temporary Files
.scannerwork/
**/.scannerwork/
scratch/
test_output.txt
Login.txt

# tests/phase2 deliberately points get_vectorstore() at a path that does not
# exist to cover the missing-store branch; Chroma creates it, so every run leaves
# this directory behind in the repository root.
non_existent_chroma_path_xyz/
