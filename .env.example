# =============================================================================
# POC-07 -- Retail Inventory Management & Procurement System
# Environment configuration template
# =============================================================================
#
# Copy this file to `.env` in the repository root and fill in the values:
#
#     cp .env.example .env
#
# The real `.env` is gitignored (.gitignore:4 `**/.env`), so a fresh clone has
# NO .env at all. Everything below therefore documents the fallback that
# actually runs when the variable is absent -- those defaults are the live
# behaviour of a clean checkout, not hypothetical.
#
# Every variable listed here is read by first-party code. Verified by censusing
# `os.getenv` / `os.environ.get` / `import.meta.env` across all .py/.jsx/.js
# files (excluding venv and node_modules). Two variables that appear in older
# .env files -- POC_ID and PHASE -- are read by NO code and are deliberately
# omitted; the poc id is a hardcoded structlog field, not configuration.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED for the AI phases (Phase 2 RAG, 3 agent, 4 MCP chat, 5 multi-agent)
# -----------------------------------------------------------------------------
# A Google AI Studio (Generative Language API) key: https://aistudio.google.com/apikey
# Without it the backend and React UI (Phase 1) still run completely, but every
# LLM and embedding call fails. Read by src/model_config.py:66.
#
# GEMINI_API_KEY is accepted as an alias; GOOGLE_API_KEY wins if both are set.
# When neither is set, model_config.api_key() returns the placeholder
# "dummy_key_for_test" so that agent/MCP modules -- which build their LLM client
# at import time -- can still be imported by the test suites without raising.
# A placeholder key means real calls return 400/401, not silence.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Free-tier note: embeddings are capped at 1000 requests/day
# (quota id EmbedContentRequestsPerDayPerUserPerProjectPerModel-FreeTier).
# Exceeding it returns HTTP 429 RESOURCE_EXHAUSTED, which Phase 2 surfaces as an
# explicit is_error result rather than as an answer. Re-running RAG ingestion
# repeatedly is what exhausts it.


# -----------------------------------------------------------------------------
# 2. Model selection -- optional, sane defaults
# -----------------------------------------------------------------------------
# Resolved centrally in src/model_config.py, which is the single source of truth
# for all five chat call sites (agents/agent.py, agents/summarizer.py,
# agents/multi_agent/agents.py, rag/rag_chain.py, mcp_server/chat_interface.py).
# Before centralisation those five sites had four different hardcoded fallbacks,
# two of which named "gemini-1.5-flash" -- a model the Generative Language API
# does not serve, confirmed against a live models.list response. On a clone with
# no .env the Phase 3 agent and its summarizer therefore requested a nonexistent
# model, and the summarizer silently degraded to its truncation fallback.
#
# Both defaults below are verified present in models.list as of 2026-08-23.
# GEMINI_MODEL is accepted as an alias for GEMINI_CHAT_MODEL.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
# GEMINI_MODEL=


# -----------------------------------------------------------------------------
# 3. Authentication / security
# -----------------------------------------------------------------------------
# JWT signing key (HS256), read by src/backend/routers/auth.py:19.
# CHANGE THIS for any deployment that is not a throwaway local run: the fallback
# is a literal committed in source, so tokens signed with it are forgeable by
# anyone with the repo. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Default if unset: "secret-key-poc-07-inventory-management-2026"
SECRET_KEY=

# Bootstrap manager account, created on backend startup by seed_default_admin()
# in src/backend/main.py. These are also the fallback credentials used by the
# service-account clients below, so if you change the admin password you should
# change SERVICE_ACCOUNT_PASSWORD to match (or set the service pair explicitly).
# Defaults if unset: admin@retail.com / admin
DEFAULT_ADMIN_EMAIL=admin@retail.com
DEFAULT_ADMIN_PASSWORD=admin

# Credentials the four non-browser API clients use to obtain a real token via
# POST /auth/login (src/service_auth.py:55). Those clients are the Phase 3 agent
# tools, the Phase 4 MCP server, the Phase 5 multi-agent graph, and the
# Streamlit UI's write path. They log in rather than minting a JWT locally, so
# no process besides the backend needs SECRET_KEY.
# Defaults if unset: admin@retail.com / admin
SERVICE_ACCOUNT_EMAIL=admin@retail.com
SERVICE_ACCOUNT_PASSWORD=admin

# Salt for the legacy pbkdf2_hmac verifier (LegacyPasswordHasher in auth.py:45),
# used only to verify pre-existing hashes that were not produced by passlib.
# Defaults to SECRET_KEY when unset -- meaning rotating SECRET_KEY invalidates
# any legacy-format hash. New passwords use passlib pbkdf2_sha256 and ignore it.
# PASSWORD_SALT=

# Comma-separated CORS allowlist, read by src/backend/main.py:114.
# Must NOT be "*": Starlette's CORSMiddleware with allow_credentials=True does
# not emit a literal wildcard -- it echoes the caller's Origin back with
# Access-Control-Allow-Credentials: true, which makes any origin a trusted one.
# Default covers the React dev server (3000) and Streamlit (8501) on both hosts.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501


# -----------------------------------------------------------------------------
# 4. Service locations
# -----------------------------------------------------------------------------
# Where the backend stores data. Relative sqlite paths are rewritten to an
# absolute path under the repo root (src/backend/database.py:17) so that running
# from a subdirectory does not silently create a second, empty database.
# Default if unset: sqlite:///<repo root>/inventory.db
# DATABASE_URL=

# Backend REST base URL for the five server-side consumers (service_auth,
# agents/tools.py, mcp_server/mcp_app.py, agents/multi_agent/agents.py,
# ui/chat_streamlit/app.py). Set this if the backend is not on localhost:8000.
# Note: agents/tools.py defaults to 127.0.0.1 rather than localhost while the
# other four default to localhost. Both reach the same server, and
# phase3/tests/test_phase3.py asserts the 127.0.0.1 form, so the difference is
# pinned by a test and intentionally left alone. Setting this variable makes all
# five agree explicitly.
# Default if unset: http://localhost:8000/api/v1 (127.0.0.1 in agents/tools.py)
# API_BASE_URL=http://localhost:8000/api/v1

# Backend base URL baked into the React bundle at build time
# (src/ui/web_react/src/App.jsx:11). Vite only exposes variables prefixed VITE_.
# This must be set at BUILD time, not run time. Note that vite.config.js also
# declares an /api proxy, but App.jsx uses this absolute URL, so the proxy is
# unused.
# Default if unset: http://localhost:8000/api/v1
# VITE_API_BASE_URL=http://localhost:8000/api/v1


# -----------------------------------------------------------------------------
# 5. Observability -- optional
# -----------------------------------------------------------------------------
# LangSmith API key. Tracing is enabled ONLY when this is set: src/rag/rag_chain.py:38
# sets LANGCHAIN_TRACING_V2=true conditionally on it. Leaving it blank is the
# supported path -- forcing tracing on without a key makes the LangChain callback
# handler POST every span to api.smith.langchain.com, get a 401, and flood stderr.
# Per-phase project names (AI-Readiness-POC-07-P2 .. -P5) are set in code.
# LANGCHAIN_API_KEY=
